# VOXERA Production Environment Template
# Copy to .env.production at repo root — NEVER commit secrets.

ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database (override in compose/k8s with service DNS)
DATABASE_URL=postgresql+asyncpg://voxera:CHANGE_ME@postgres:5432/voxera

# Security — generate with: openssl rand -base64 32
JWT_SECRET_KEY=
API_KEY_SECRET=
ENCRYPTION_SECRET_KEY=

# CORS — production origins
CORS_ORIGINS=https://app.voxera.example.com,https://voxera.example.com

# Knowledge
KNOWLEDGE_STORAGE_PATH=/data/knowledge
KNOWLEDGE_REQUIRE_PROVIDERS=true

# Voice (enable when providers configured)
VOICE_REQUIRE_PROVIDERS=true
STT_PROVIDER=deepgram
LLM_PROVIDER=openai
TTS_PROVIDER=elevenlabs

# Twilio
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_BASE_URL=https://api.voxera.example.com

# Provider API keys
VOICE_OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Postgres (docker-compose.prod.yml)
POSTGRES_USER=voxera
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=voxera

# Frontend build args (reverse proxy)
VITE_API_URL=/api/v1
VITE_WS_URL=wss://api.voxera.example.com/api/v1

# Migrations
RUN_MIGRATIONS=true
VALIDATE_CONFIG=true

# Secrets provider: local | aws | azure | gcp | vault
IAM_SECRET_PROVIDER=local
