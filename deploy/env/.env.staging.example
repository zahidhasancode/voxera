# Staging environment template
# Copy to .env.staging for staging deployments

ENVIRONMENT=staging
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=2

DATABASE_URL=postgresql+asyncpg://voxera:CHANGE_ME@postgres:5432/voxera

JWT_SECRET_KEY=
API_KEY_SECRET=
ENCRYPTION_SECRET_KEY=

CORS_ORIGINS=https://app.staging.voxera.example.com

KNOWLEDGE_STORAGE_PATH=/data/knowledge
KNOWLEDGE_REQUIRE_PROVIDERS=true
VOICE_REQUIRE_PROVIDERS=false

RUN_MIGRATIONS=true
VALIDATE_CONFIG=true

POSTGRES_USER=voxera
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=voxera

VITE_API_URL=/api/v1
VITE_WS_URL=wss://api.staging.voxera.example.com/api/v1

IAM_SECRET_PROVIDER=local
