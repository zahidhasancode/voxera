# VOXERA Backend Configuration
# Copy this file to .env and update values as needed

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: development, staging, production
# Determines default values for server, CORS, WebSocket, and logging settings
ENVIRONMENT=development

# =============================================================================
# PROJECT SETTINGS
# =============================================================================
PROJECT_NAME=VOXERA Backend
API_V1_STR=/api/v1

# =============================================================================
# SERVER SETTINGS
# =============================================================================
HOST=0.0.0.0
PORT=8000

# Auto-reload on code changes (None = auto-detect from ENVIRONMENT)
# development: true, staging/production: false
RELOAD=

# Number of worker processes (None = auto-detect from ENVIRONMENT)
# development: 1, staging: 2, production: 4
WORKERS=

# =============================================================================
# CORS SETTINGS
# =============================================================================
# Allowed CORS origins (comma-separated or JSON array string)
# Empty = use environment defaults:
#   development: localhost:3000, localhost:8080
#   staging: staging.voxera.com, staging-app.voxera.com
#   production: voxera.com, app.voxera.com
# Example: http://localhost:3000,http://localhost:8080
# Example JSON: ["http://localhost:3000","http://localhost:8080"]
CORS_ORIGINS=

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Separate secrets (required in staging/production when DATABASE_URL is set)
JWT_SECRET_KEY=
API_KEY_SECRET=
ENCRYPTION_SECRET_KEY=

# Legacy fallback for local development only (minimum 32 characters)
SECRET_KEY=

# Twilio webhook signature validation
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_BASE_URL=
TWILIO_STREAM_TOKEN_TTL_SECONDS=300

# =============================================================================
# VOICE PROVIDERS (STT / LLM / TTS)
# =============================================================================
VOICE_REQUIRE_PROVIDERS=false
STT_PROVIDER=deepgram
LLM_PROVIDER=openai
TTS_PROVIDER=elevenlabs
VOICE_LLM_MODEL=gpt-4o-mini
VOICE_LLM_FAILOVER_PROVIDER=
VOICE_TTS_VOICE_ID=
VOICE_TTS_MODEL=tts-1
VOICE_OPENAI_API_KEY=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
ANTHROPIC_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_turbo_v2_5
VOICE_MAX_CONCURRENT_CALLS=1000
VOICE_IDLE_TIMEOUT_SECONDS=300

# =============================================================================
# WEBSOCKET SETTINGS
# =============================================================================
# Maximum concurrent WebSocket connections (None = auto-detect from ENVIRONMENT)
# development: 50, staging: 200, production: 1000
WEBSOCKET_MAX_CONNECTIONS=

# WebSocket ping interval in seconds (None = auto-detect from ENVIRONMENT)
# development: 30, staging/production: 20
WEBSOCKET_PING_INTERVAL=

# WebSocket ping timeout in seconds (None = auto-detect from ENVIRONMENT)
# All environments: 10
WEBSOCKET_PING_TIMEOUT=

# =============================================================================
# LOGGING SETTINGS
# =============================================================================
# Log level (None = auto-detect from ENVIRONMENT)
# Options: DEBUG, INFO, WARNING, ERROR
# development: DEBUG, staging: INFO, production: WARNING
LOG_LEVEL=

# =============================================================================
# DATABASE (Enterprise multi-tenant persistence)
# =============================================================================
# Async PostgreSQL URL for SQLAlchemy 2.x + asyncpg
# Leave empty to run voice streaming only (enterprise REST APIs return 503)
# Example: postgresql+asyncpg://voxera:voxera@localhost:5432/voxera
DATABASE_URL=

# Echo SQL to logs (development only)
DATABASE_ECHO=false

# Connection pool sizing
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# KNOWLEDGE INGESTION
# =============================================================================
KNOWLEDGE_STORAGE_PATH=data/knowledge
KNOWLEDGE_DEFAULT_CHUNK_SIZE=512
KNOWLEDGE_DEFAULT_CHUNK_OVERLAP=64
# Provider identifiers only — implementations registered separately
KNOWLEDGE_DEFAULT_EMBEDDING_PROVIDER=
KNOWLEDGE_DEFAULT_VECTOR_STORE=
KNOWLEDGE_REQUIRE_PROVIDERS=false
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
KNOWLEDGE_JOB_MAX_RETRIES=3
KNOWLEDGE_JOB_RETRY_DELAY_SECONDS=30
KNOWLEDGE_CACHE_TTL_SECONDS=3600
KNOWLEDGE_ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv,html,htm
# Maximum upload size in bytes (default 50 MB)
KNOWLEDGE_MAX_UPLOAD_BYTES=52428800

# Embedding provider credentials
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
VOYAGE_API_KEY=
VOYAGE_API_BASE=https://api.voyageai.com/v1
NOMIC_API_KEY=
NOMIC_API_BASE=https://api-atlas.nomic.ai/v1
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
BGE_EMBEDDING_URL=
BGE_API_KEY=

# Vector store credentials
QDRANT_URL=
QDRANT_API_KEY=
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=
WEAVIATE_URL=
WEAVIATE_API_KEY=
MILVUS_URL=
MILVUS_TOKEN=

# =============================================================================
# ENTERPRISE RAG / RETRIEVAL ENGINE
# =============================================================================
RAG_CACHE_TTL_SECONDS=300
RAG_EMBEDDING_CACHE_TTL_SECONDS=3600
RAG_MAX_CONTEXT_TOKENS=4096
RAG_MIN_SIMILARITY_THRESHOLD=0.65
RAG_DEFAULT_TOP_K=8
RAG_ENABLE_RETRIEVAL_CACHE=true

# =============================================================================
# ENTERPRISE MEMORY SYSTEM
# =============================================================================
MEMORY_MAX_CONTEXT_TOKENS=8192
MEMORY_SUMMARY_TURN_THRESHOLD=12
MEMORY_COMPRESSION_ENABLED=true
MEMORY_CACHE_TTL_SECONDS=300
MEMORY_WORKING_MEMORY_TTL_SECONDS=3600
MEMORY_SESSION_EXPIRY_HOURS=24
MEMORY_MAX_TURNS_BEFORE_COMPRESS=20

# =============================================================================
# ENTERPRISE TOOL EXECUTION FRAMEWORK
# =============================================================================
TOOL_EXECUTION_TIMEOUT_SECONDS=30
TOOL_MAX_RETRIES=3
TOOL_RETRY_BASE_DELAY_MS=200
TOOL_CIRCUIT_FAILURE_THRESHOLD=5
TOOL_CIRCUIT_RECOVERY_SECONDS=60
TOOL_RATE_LIMIT_PER_MINUTE=120
TOOL_ALLOWED_HTTP_HOSTS=
TOOL_ENABLE_BUILTIN_TOOLS=true

# =============================================================================
# ENTERPRISE PLANNER AGENT
# =============================================================================
PLANNER_MAX_REASONING_STEPS=5
PLANNER_MIN_CONFIDENCE=0.55
PLANNER_CACHE_TTL_SECONDS=300
PLANNER_MAX_CONTEXT_TOKENS=6144
PLANNER_ENABLE_CACHE=true
PLANNER_MODEL_PROVIDER=structured
PLANNER_ESCALATION_CONFIDENCE_THRESHOLD=0.40
PLANNER_DEFAULT_LANGUAGE=en

# =============================================================================
# ENTERPRISE VERIFIER AGENT
# =============================================================================
VERIFIER_CACHE_TTL_SECONDS=300
VERIFIER_ENABLE_CACHE=true
VERIFIER_MIN_CONFIDENCE=0.50
VERIFIER_KNOWLEDGE_MIN_SIMILARITY=0.65
VERIFIER_MODEL_PROVIDER=structured
VERIFIER_REFUND_HUMAN_THRESHOLD_USD=500
VERIFIER_AUTO_APPROVE_LOW_RISK=true

# =============================================================================
# ENTERPRISE WORKFLOW & POLICY ENGINE
# =============================================================================
WORKFLOW_DEFAULT_TIMEOUT_SECONDS=3600
WORKFLOW_APPROVAL_TIMEOUT_SECONDS=1800
WORKFLOW_MAX_RETRIES=3
WORKFLOW_RETRY_DELAY_SECONDS=30
WORKFLOW_DEFAULT_TIMEZONE=UTC
WORKFLOW_ENABLE_EVENT_BUS=true
WORKFLOW_MAX_STEPS=50

# =============================================================================
# ENTERPRISE IAM
# =============================================================================
IAM_ACCESS_TOKEN_EXPIRE_MINUTES=60
IAM_REFRESH_TOKEN_EXPIRE_DAYS=30
IAM_SESSION_MAX_CONCURRENT=10
IAM_API_KEY_PREFIX=vx_
IAM_PASSWORD_MIN_LENGTH=12
IAM_MFA_ISSUER=VOXERA
IAM_MAGIC_LINK_EXPIRE_MINUTES=15
IAM_ENABLE_API_KEY_AUTH=true
IAM_SECRET_PROVIDER=local

# =============================================================================
# PLATFORM RELIABILITY
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_IP=300
RATE_LIMIT_PER_ENDPOINT=120
RATE_LIMIT_PER_ORGANIZATION=600
REQUEST_TIMEOUT_ENABLED=true
REQUEST_TIMEOUT_DEFAULT_SECONDS=30
REQUEST_TIMEOUT_KNOWLEDGE_SECONDS=45
REQUEST_TIMEOUT_PLANNER_SECONDS=60
REQUEST_TIMEOUT_VERIFIER_SECONDS=60
REQUEST_TIMEOUT_TOOLS_SECONDS=45
REQUEST_TIMEOUT_WORKFLOW_SECONDS=90
SHUTDOWN_DRAIN_TIMEOUT_SECONDS=30
